    <string name="app_info_section">ऐप की जानकारी</string><string name="app_info_entry">ऐप की जानकारी</string><string name="app_info_title">ऐप की जानकारी</string><string name="app_tagline">प्रिंट करने योग्य फोटो कार्ड, AAC के लिए भी</string><string name="app_description">PhotoCard Libre एक निःशुल्क और ओपन-सोर्स Android ऐप है, जिससे स्मार्टफोन पर सीधे प्रिंट करने योग्य फोटो कार्ड बनाए जा सकते हैं।</string><string name="app_use_aac">इसे संवर्धित और वैकल्पिक संचार (AAC) के संदर्भ में भी इस्तेमाल किया जा सकता है। इसमें रोज़मर्रा के लोगों, वस्तुओं, स्थानों और गतिविधियों से जुड़ी तस्वीरों के साथ अधिकतम 4 शब्दों के छोटे कैप्शन वाले कार्ड बनाए जा सकते हैं।</string><string name="app_gallery_description">तस्वीरें सीधे स्मार्टफोन की गैलरी से चुनी जा सकती हैं, उन्हें किसी दूसरे डिवाइस पर भेजने की आवश्यकता नहीं है।</string><string name="app_support_limit">PhotoCard Libre एक सहायक उपकरण है और पूर्ण AAC सॉफ़्टवेयर या पेशेवर उपकरणों का स्थान नहीं लेता।</string><string name="supported_formats">समर्थित फ़ॉर्मेट: JPEG और PNG</string><string name="supported_formats_label">समर्थित फ़ॉर्मेट</string><string name="supported_formats_value">JPEG और PNG</string><string name="open_source_description">मुक्त और ओपन-सोर्स सॉफ़्टवेयर</string>
    <string name="version_label">संस्करण</string><string name="software_license_label">सॉफ़्टवेयर लाइसेंस</string><string name="software_license_value">GNU GPL v3 या बाद का संस्करण</string><string name="graphic_resources_license_label">मूल ग्राफ़िक सामग्री</string><string name="graphic_resources_license_value">CC BY 4.0</string><string name="ai_assistance_label">ग्राफ़िक सामग्री</string><string name="ai_assistance_description">कुछ ग्राफ़िक सामग्री AI जनरेशन टूल की सहायता से बनाई गई है।</string><string name="project_label">प्रोजेक्ट</string><string name="source_repository_label">सोर्स कोड</string><string name="report_issue_label">समस्या की रिपोर्ट करें</string><string name="privacy_label">गोपनीयता</string><string name="privacy_description">तस्वीरों को डिवाइस पर ही प्रोसेस किया जाता है। तस्वीरें और कैप्शन डिवाइस पर ही रहते हैं और बाहरी सर्वर पर अपलोड नहीं किए जाते। ऐप को इंटरनेट एक्सेस की आवश्यकता नहीं है।</string><string name="credits_label">क्रेडिट</string><string name="credits_description">PhotoCard Libre एक स्वतंत्र और मुक्त परियोजना है।</string><string name="value_to_be_defined">बाद में निर्धारित किया जाएगा</string>
