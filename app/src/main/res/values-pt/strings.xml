    <string name="app_tagline">Cartões fotográficos imprimíveis, também para CAA/AAC</string>
    <string name="app_description">PhotoCard Libre é uma aplicação gratuita e de código aberto para criar cartões fotográficos imprimíveis diretamente no smartphone.</string>
    <string name="app_use_aac">Também pode ser útil em contextos de Comunicação Aumentativa e Alternativa (CAA/AAC), para criar cartões com fotografias e legendas curtas de até 4 palavras relacionadas com pessoas, objetos, lugares e atividades do dia a dia.</string>
    <string name="app_gallery_description">As imagens podem ser escolhidas diretamente na galeria do smartphone, sem necessidade de as transferir para outro dispositivo.</string>
    <string name="app_support_limit">PhotoCard Libre é uma ferramenta de apoio e não substitui software CAA completo nem ferramentas profissionais específicas.</string>
